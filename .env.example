# Copia este archivo a /etc/kotoduo.env y completa los valores. NUNCA lo subas a git con datos reales.
# (Los comentarios van en su propia línea: systemd los leería como parte del valor si van al final.)

# --- Obligatorias en producción ---
DEBUG=1
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=
ALLOWED_HOSTS=kotoduo.tudominio.cl
CSRF_TRUSTED_ORIGINS=https://kotoduo.tudominio.cl

# --- Base de datos MySQL 8 (si no defines DB_NAME se usa SQLite de desarrollo) ---
DEBUG=1
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=kotoduo
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# --- Opcionales ---
# Proxies de confianza delante de Django (nginx = 1)
NUM_PROXIES=1
# 0 solo si el proxy ya redirige a HTTPS
SSL_REDIRECT=1
# Súbelo a 31536000 cuando HTTPS funcione bien (es difícil de revertir)
HSTS_SECONDS=0
# Horas de inactividad antes de pedir login otra vez
SESSION_HORAS=12
LOG_LEVEL=INFO
# Carpeta compartida entre procesos de gunicorn (límite de intentos de login). Debe existir y ser escribible.
CACHE_DIR=/var/cache/kotoduo
